# 复制为 .env 后填写；.env 不提交，.env.example 只保存无密钥的模板。
# 读取顺序：进程环境变量 > 项目根 .env > 代码默认值。修改后重启对应服务。
# 本项目只使用 Anthropic Messages 协议；不能直接填 OpenAI /v1 接口。

# ===== 当前模型供应商 =====
# ollama / deepseek / kimi / anthropic / custom
# 未设置或留空时使用 ollama。
LLM_PROVIDER=ollama

# 每组 BASE_URL / API_KEY / MODEL / AUTH_MODE 独立；MODELS 是网页下拉列表，可逗号分隔。
# 只检查当前供应商的密钥，其他供应商可以留空。

# ===== 本地 Ollama（默认） =====
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_AUTH_MODE=api_key
OLLAMA_MODELS=

# ===== DeepSeek：填写开放平台 API Key 后选 LLM_PROVIDER=deepseek =====
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_AUTH_MODE=bearer
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro

# ===== Kimi 国内开放平台；海外账号请使用对应平台端点和 Key =====
KIMI_BASE_URL=https://api.moonshot.cn/anthropic
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_AUTH_MODE=bearer
KIMI_MODELS=kimi-k3

# ===== Anthropic：MODEL 填账号可用的完整模型 ID =====
# BASE_URL 默认 https://api.anthropic.com。
# ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_AUTH_MODE=api_key
ANTHROPIC_MODELS=

# ===== 其他 Anthropic Messages 兼容服务 =====
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_AUTH_MODE=api_key
CUSTOM_MODELS=

# ===== 工作目录和运行预算 =====
# 留空使用启动时工作目录；网页仍可选择项目。不要把机器专属绝对路径提交到模板。
AGENT_WORKDIR=
# Web 后端初始模式：auto / manual / plan；会话/请求中的显式模式优先，CLI 不使用此审批模式。
AGENT_MODE=auto
# 压缩历史的阈值，和单次运行的 Token 总预算是两回事。
TOKEN_THRESHOLD=100000
AGENT_MAX_ROUNDS=40
AGENT_MAX_TOOL_CALLS=100
AGENT_MAX_SECONDS=600
AGENT_MAX_TOKENS=100000
AGENT_MAX_REPAIR_ATTEMPTS=2
# 可选，例如 python3 -m pytest -q；必须适用于当前项目。留空不自动验证。
AGENT_VERIFY_COMMAND=

# ===== Web 服务和开发服务器 =====
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173
# 留空自动使用 http://127.0.0.1:<API_PORT>，仅供 Vite 服务端转发。
API_PROXY_TARGET=
# 保留原有 * 默认值；也可设为逗号分隔的浏览器来源列表。
API_CORS_ORIGINS=*
# Manual 模式工具审批等待秒数。
TOOL_APPROVAL_TIMEOUT=120

# ===== 可选 GitHub MCP：Token 留空时关闭 =====
GITHUB_MCP_TOKEN=
GITHUB_MCP_TIMEOUT=20

# ===== 可选独立 A2A 审查 =====
# URL 留空时主 Agent 不请求审查服务。
A2A_REVIEW_URL=
# 主服务与审查服务间的共享令牌，不是模型 API Key。
A2A_REVIEW_TOKEN=
A2A_REVIEW_TIMEOUT=120
# 审查进程使用的供应商；留空继承 LLM_PROVIDER。MODEL 留空继承所选供应商模型。
A2A_REVIEW_PROVIDER=
A2A_REVIEW_MODEL=
